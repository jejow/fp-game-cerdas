<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Branding/identity.uss" />
    <Style src="team-choice.uss" />
    <ui:VisualElement name="Background" class="team-screen identity-font">
        <ui:Label text="CHOOSE YOUR ROBOT FACTION" class="team-heading" />
        <ui:Label text="Two protocols. One battlefield." class="team-subheading" />
        <ui:VisualElement class="team-cards">
            <ui:Button name="Corpo" class="robot-team-card corpo-card">
                <ui:Label text="CORPO" class="team-name" />
                <ui:Label text="ASSAULT ROBOTS" class="team-role" />
                <ui:VisualElement name="CorpoPortrait" class="robot-portrait corpo-portrait" />
                <ui:Label text="Plant the bomb. Secure the site." class="team-objective" />
                <ui:Label name="TeamCount" class="team-count" />
            </ui:Button>
            <ui:Button name="Natif" class="robot-team-card natif-card">
                <ui:Label text="NATIF" class="team-name" />
                <ui:Label text="DEFENSE ROBOTS" class="team-role" />
                <ui:VisualElement name="NatifPortrait" class="robot-portrait natif-portrait" />
                <ui:Label text="Protect the sites. Defuse the bomb." class="team-objective" />
                <ui:Label name="TeamCount" class="team-count" />
            </ui:Button>
        </ui:VisualElement>
        <ui:Button name="Spectator" text="SPECTATE" class="spectator-button" />
    </ui:VisualElement>
</ui:UXML>
