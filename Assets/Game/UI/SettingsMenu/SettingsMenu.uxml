<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Branding/identity.uss" />
    <Style src="settings-menu.uss" />
    <ui:VisualElement name="Container" class="settings-card identity-font">
        <ui:Label text="SETTINGS" class="settings-title" />
        <ui:Label text="LOCAL PILOT PREFERENCES" class="settings-subtitle" />
        <ui:ScrollView horizontal-scroller-visibility="Hidden" class="settings-scroll">
            <ui:VisualElement class="setting-block">
                <ui:Label text="MOUSE SENSITIVITY" class="setting-label" />
                <ui:VisualElement class="setting-controls">
                    <ui:Slider name="SensitivitySlider" value="1" low-value="0.1" high-value="10" class="setting-slider" />
                    <ui:FloatField name="SensitivityField" value="1" class="setting-number" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="setting-block">
                <ui:Label text="MASTER VOLUME" class="setting-label" />
                <ui:VisualElement class="setting-controls">
                    <ui:Slider name="VolumeSlider" value="50" low-value="0" high-value="100" class="setting-slider" />
                    <ui:FloatField name="VolumeField" value="50" class="setting-number" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="setting-block">
                <ui:Label text="UNIT CALLSIGN" class="setting-label" />
                <ui:TextField name="PseudoField" placeholder-text="UNIT-07" max-length="15" class="setting-callsign" />
                <ui:Label text="Your name during offline operations." class="setting-hint" />
            </ui:VisualElement>
        </ui:ScrollView>
        <ui:Button name="SaveButton" text="SAVE &amp; CLOSE" class="settings-save" />
    </ui:VisualElement>
</ui:UXML>
