.settings-card { width: 100%; height: 100%; padding: 32px; background-color: rgb(10, 23, 34); border-width: 1px; border-color: rgb(68, 107, 129); }
.settings-title { font-size: 30px; -unity-font-style: bold; margin: 0; padding: 0; }
.settings-subtitle { font-size: 12px; color: rgb(117, 176, 195); margin-top: 12px; }
.settings-scroll { flex-grow: 1; flex-shrink: 1; margin-top: 32px; margin-bottom: 20px; }
.setting-block { margin-bottom: 32px; }
.setting-label { font-size: 15px; color: rgb(179, 204, 218); margin-bottom: 14px; }
.setting-controls { flex-direction: row; align-items: center; }
.setting-slider { flex-grow: 1; margin-right: 18px; height: 38px; }
.setting-slider #unity-tracker { height: 4px; background-color: rgb(60, 98, 119); }
.setting-slider #unity-dragger { width: 12px; height: 18px; border-radius: 2px; background-color: rgb(112, 219, 233); border-width: 0; }
.setting-number { width: 92px; height: 42px; font-size: 19px; }
.setting-callsign { height: 44px; font-size: 19px; }
.setting-number .unity-base-text-field__input, .setting-callsign .unity-base-text-field__input { background-color: rgb(24, 45, 59); color: rgb(223, 237, 245); border-width: 1px; border-color: rgb(64, 102, 123); border-radius: 0; padding: 8px 12px; }
.setting-hint { font-size: 12px; white-space: normal; color: rgb(111, 145, 165); margin-top: 10px; }
.settings-save { flex-shrink: 0; height: 52px; font-size: 18px; -unity-font-style: bold; color: rgb(9, 24, 31); background-color: rgb(111, 216, 231); border-width: 0; border-radius: 0; }
.settings-save:hover, .settings-save:focus { background-color: rgb(170, 239, 247); }
