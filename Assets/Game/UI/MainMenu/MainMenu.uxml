<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/MainMenu/main-menu.uss?fileID=7433441132597879392&amp;guid=a94d734d4c6be40489081ba40fa40f7f&amp;type=3#main-menu" />
    <Style src="project://database/Assets/Game/UI/PauseMenu/pause-menu.uss?fileID=7433441132597879392&amp;guid=3eed4f54b20f08a4da6bc1bc1e3bff2e&amp;type=3#pause-menu" />
    <ui:VisualElement name="Background" style="flex-grow: 1; visibility: visible; display: flex; flex-direction: row;">
        <ui:VisualElement name="Logo" style="flex-grow: 1; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/Game/Art/HUD_General/MENU/TITRE_Update.png?fileID=2800000&amp;guid=00863b5ed2af81b4fa484479619d4f02&amp;type=3#TITRE_Update&quot;); width: 927px; height: 234px; position: absolute; top: 100px; left: 100px;" />
        <ui:VisualElement name="MainMenuElements" class="element-background" style="width: 600px; position: absolute; left: 50px; top: 400px;">
            <ui:Button text="   Play Offline" name="PlayButton" class="main-menu-button" />
            <ui:Button text="   Settings" name="SettingsButton" class="main-menu-button" />
            <ui:Button text="   Credits" name="CreditsButton" class="main-menu-button" />
            <ui:Button text="   Quit" name="QuitButton" class="main-menu-button" />
        </ui:VisualElement>
        <ui:VisualElement name="Container" style="flex-grow: 1; position: absolute; bottom: 100px; right: 100px; width: 1200px; height: 600px;" />
        <ui:VisualElement name="BotSetup" class="bot-setup" style="display: none;">
            <ui:Label text="CUSTOM BOT MATCH" class="bot-title" />
            <ui:Label text="Choose your team and build an offline match." class="bot-subtitle" />
            <ui:ScrollView name="BotSetupScroll" horizontal-scroller-visibility="Hidden" class="bot-scroll">
                <ui:VisualElement class="bot-map-card">
                    <ui:Label text="SUNA · BOMB DEFUSAL" class="bot-map-title" />
                    <ui:Label text="Corpo plants the bomb. Natif defends the sites and defuses it." class="bot-hint" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Your team" class="bot-field-label" />
                    <ui:DropdownField name="PlayerTeam" class="bot-field" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Friendly bots" class="bot-field-label" />
                    <ui:DropdownField name="AllyBots" class="bot-field" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Enemy bots" class="bot-field-label" />
                    <ui:DropdownField name="EnemyBots" class="bot-field" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Bot difficulty" class="bot-field-label" />
                    <ui:DropdownField name="BotDifficulty" class="bot-field" />
                </ui:VisualElement>
                <ui:Label name="BotDescription" class="bot-hint bot-description" />
                <ui:VisualElement class="bot-presets">
                    <ui:Label text="Quick setup" class="bot-hint" />
                    <ui:Button name="DuelPreset" text="1 VS 1" class="bot-small-button" />
                    <ui:Button name="FullTeamsPreset" text="5 VS 5" class="bot-small-button" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Label name="MatchSummary" class="bot-summary" />
            <ui:VisualElement class="bot-actions">
                <ui:Button name="BackFromBotSetup" text="BACK" class="bot-action-button" />
                <ui:Button name="StartOffline" text="START MATCH" class="bot-action-button bot-start-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ConnectionFeedback">
            <ui:Label text="Status" style="-unity-text-align: middle-center; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: -5px;" />
            <ui:VisualElement name="BackGround" style="height: 30px; width: 90%; background-color: rgba(0, 0, 0, 0.5); top: -5px;">
                <ui:VisualElement name="Fill" style="width: 0; flex-grow: 1; background-color: rgb(255, 255, 255);" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
