<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="../Branding/identity.uss" />
    <Style src="main-menu.uss" />
    <Style src="../PauseMenu/pause-menu.uss" />
    <ui:VisualElement name="Background" class="menu-background identity-font">
        <ui:VisualElement class="menu-shade" picking-mode="Ignore" />
        <ui:VisualElement name="Logo" class="menu-brand">
            <ui:Label text="AUTONOMOUS COMBAT DIVISION / 01" class="menu-eyebrow" />
            <ui:Label text="STEEL PROTOCOL" class="game-title menu-title" />
            <ui:Label text="TACTICAL ROBOT COMBAT" class="game-tagline" />
        </ui:VisualElement>
        <ui:VisualElement name="MainMenuElements" class="menu-actions">
            <ui:Label text="SELECT AN OPERATION" class="menu-section-label" />
            <ui:Button text="PLAY OFFLINE" name="PlayButton" class="main-menu-button main-menu-primary" />
            <ui:Button text="SETTINGS" name="SettingsButton" class="main-menu-button" />
            <ui:Button text="QUIT GAME" name="QuitButton" class="main-menu-button" />
        </ui:VisualElement>
        <ui:VisualElement name="RobotReadout" class="robot-readout" picking-mode="Ignore">
            <ui:Label text="UNIT 07 / CORPO" class="readout-kicker" />
            <ui:Label text="ASSAULT AUTOMATON" class="readout-name" />
            <ui:Label text="COMBAT SYSTEMS READY" class="readout-status" />
        </ui:VisualElement>
        <ui:VisualElement class="menu-status" picking-mode="Ignore">
            <ui:VisualElement class="status-dot" />
            <ui:Label text="OFFLINE / LOCAL OPERATIONS" />
        </ui:VisualElement>
        <ui:VisualElement class="menu-footer" picking-mode="Ignore">
            <ui:Label text="PRECISION. MACHINES. PROTOCOL." />
            <ui:Label text="BOMB DEFUSAL   /   ROBOT FACTIONS   /   SOLO + BOTS" />
        </ui:VisualElement>
        <ui:VisualElement name="Container" class="settings-container" />
        <ui:VisualElement name="BotSetup" class="bot-setup">
            <ui:Label text="CUSTOM BOT MATCH" class="bot-title" />
            <ui:Label text="Choose a robot faction and configure your offline match." class="bot-subtitle" />
            <ui:ScrollView name="BotSetupScroll" horizontal-scroller-visibility="Hidden" class="bot-scroll">
                <ui:VisualElement class="bot-map-card">
                    <ui:Label text="ROBOT OPERATIONS / BOMB DEFUSAL" class="bot-map-title" />
                    <ui:Label text="Corpo assault robots plant the bomb. Natif defense robots protect the sites and defuse it." class="bot-hint" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Your team" class="bot-field-label" />
                    <ui:DropdownField name="PlayerTeam" class="bot-field" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Friendly bots" class="bot-field-label" />
                    <ui:DropdownField name="AllyBots" class="bot-field" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Enemy bots" class="bot-field-label" />
                    <ui:DropdownField name="EnemyBots" class="bot-field" />
                </ui:VisualElement>
                <ui:VisualElement class="bot-row">
                    <ui:Label text="Bot difficulty" class="bot-field-label" />
                    <ui:DropdownField name="BotDifficulty" class="bot-field" />
                </ui:VisualElement>
                <ui:Label name="BotDescription" class="bot-hint bot-description" />
                <ui:VisualElement class="bot-presets">
                    <ui:Label text="Quick setup" class="bot-hint" />
                    <ui:Button name="DuelPreset" text="1 VS 1" class="bot-small-button" />
                    <ui:Button name="FullTeamsPreset" text="5 VS 5" class="bot-small-button" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:Label name="MatchSummary" class="bot-summary" />
            <ui:VisualElement class="bot-actions">
                <ui:Button name="BackFromBotSetup" text="BACK" class="bot-action-button" />
                <ui:Button name="StartOffline" text="START MATCH" class="bot-action-button bot-start-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ConnectionFeedback" class="identity-font">
            <ui:Label name="LoadingStatus" text="PREPARING OPERATION" />
            <ui:VisualElement class="menu-loading-track">
                <ui:VisualElement name="Fill" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
