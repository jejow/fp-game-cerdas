.menu-background { flex-grow: 1; }
.menu-shade { position: absolute; left: 0; top: 0; bottom: 0; width: 47%; background-color: rgba(6, 12, 19, 0.82); }
.menu-brand { position: absolute; left: 6%; top: 12%; width: 88%; }
.menu-eyebrow { color: rgb(113, 144, 158); font-size: 15px; margin: 0 0 22px 0; padding: 0; }
.menu-title { font-size: 80px; margin-bottom: 12px; }
.menu-actions { position: absolute; left: 6%; top: 43%; width: 430px; }
.menu-section-label { color: rgb(97, 129, 145); font-size: 12px; margin: 0 0 18px 0; padding: 0; }
.main-menu-button {
    width: 100%; height: 66px; margin: 0 0 10px 0; padding: 0 0 0 24px;
    -unity-text-align: middle-left; font-size: 24px; -unity-font-style: bold;
    color: rgb(199, 216, 225); background-color: rgba(18, 33, 44, 0.82);
    border-radius: 0; border-width: 1px; border-color: rgb(42, 64, 77);
    border-left-width: 3px; border-left-color: rgb(59, 94, 112);
    transition-property: background-color, color, border-left-color;
    transition-duration: 0.12s;
}
.main-menu-primary { color: rgb(10, 22, 29); background-color: rgb(105, 214, 229); border-color: rgb(105, 214, 229); }
.main-menu-button:hover, .main-menu-button:focus { background-color: rgb(35, 65, 82); color: white; border-left-color: rgb(121, 230, 243); }
.main-menu-primary:hover, .main-menu-primary:focus { background-color: rgb(164, 237, 245); color: rgb(9, 24, 31); }
.main-menu-button:active { background-color: rgb(67, 114, 135); }
.menu-status { position: absolute; right: 6%; top: 5%; flex-direction: row; align-items: center; color: rgb(151, 181, 192); font-size: 13px; }
.status-dot { width: 7px; height: 7px; border-radius: 4px; margin-right: 10px; background-color: rgb(117, 220, 181); }
.menu-footer { position: absolute; left: 6%; right: 6%; bottom: 5%; flex-direction: row; justify-content: space-between; color: rgb(98, 127, 145); font-size: 12px; border-top-width: 1px; border-top-color: rgb(40, 63, 76); padding-top: 22px; }
.robot-readout { position: absolute; left: 79%; right: 5%; bottom: 24%; }
.readout-kicker { color: rgb(240, 176, 91); font-size: 13px; margin-bottom: 10px; }
.readout-name { color: rgb(222, 233, 239); font-size: 19px; white-space: normal; }
.readout-status { color: rgb(110, 150, 166); font-size: 11px; margin-top: 7px; }
.settings-container { position: absolute; left: 53%; right: 6%; top: 18%; bottom: 18%; }
.bot-setup {
    display: none; position: absolute; left: 20%; right: 20%; top: 8%; bottom: 14%;
    padding: 30px 40px; color: rgb(230, 239, 244);
    background-color: rgba(10, 21, 31, 0.98); border-width: 1px; border-color: rgb(72, 116, 136);
}
.bot-title { font-size: 31px; -unity-font-style: bold; margin-bottom: 8px; }
.bot-subtitle { font-size: 16px; color: rgb(137, 167, 184); margin-bottom: 20px; white-space: normal; }
.bot-scroll { flex-grow: 1; flex-shrink: 1; }
.bot-map-card { padding: 14px; margin-bottom: 22px; border-left-width: 3px; border-left-color: rgb(98, 207, 224); background-color: rgb(20, 38, 50); }
.bot-map-title { font-size: 18px; margin-bottom: 9px; }
.bot-hint { font-size: 15px; white-space: normal; color: rgb(153, 179, 193); }
.bot-row { flex-direction: row; align-items: center; margin-bottom: 12px; min-height: 44px; }
.bot-field-label { width: 32%; font-size: 19px; }
.bot-field { flex-grow: 1; height: 44px; font-size: 17px; }
.bot-field .unity-base-field__input { background-color: rgb(26, 46, 60); color: rgb(229, 239, 245); border-width: 1px; border-color: rgb(60, 90, 107); padding-left: 14px; padding-right: 10px; }
.bot-description { margin-left: 32%; margin-bottom: 18px; min-height: 40px; }
.bot-presets { flex-direction: row; align-items: center; flex-wrap: wrap; margin-bottom: 12px; }
.bot-small-button { height: 42px; width: 130px; margin-left: 16px; font-size: 17px; color: rgb(203, 225, 237); background-color: rgb(28, 50, 65); border-radius: 0; border-width: 1px; border-color: rgb(51, 83, 101); }
.bot-summary { font-size: 20px; color: rgb(123, 214, 229); margin-top: 18px; margin-bottom: 18px; }
.bot-actions { flex-direction: row; justify-content: space-between; flex-shrink: 0; }
.bot-action-button { width: 31%; height: 56px; font-size: 20px; color: rgb(220, 236, 243); background-color: rgb(28, 47, 60); border-radius: 0; border-width: 1px; border-color: rgb(65, 100, 119); }
.bot-start-button { width: 59%; color: rgb(9, 24, 31); background-color: rgb(106, 215, 229); border-color: rgb(106, 215, 229); -unity-font-style: bold; }
.bot-action-button:hover, .bot-small-button:hover { background-color: rgb(57, 97, 119); color: white; }
.bot-action-button:focus, .bot-small-button:focus { border-color: rgb(154, 230, 242); }
#ConnectionFeedback { display: none; position: absolute; left: 20%; right: 20%; bottom: 5%; padding: 14px 22px; background-color: rgb(11, 23, 33); border-width: 1px; border-color: rgb(49, 82, 100); font-size: 16px; }
.menu-loading-track { height: 4px; margin-top: 12px; background-color: rgb(28, 49, 62); }
#Fill { height: 100%; width: 0; background-color: rgb(111, 220, 233); }
